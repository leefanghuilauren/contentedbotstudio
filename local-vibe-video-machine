import os

def find_local_assets(scene_descriptions, dataset_path):
    """Matches script scenes to existing files in your local video folder."""
    matched_files = []
    all_videos = os.listdir(dataset_path)
    
    for scene in scene_descriptions:
        # Simple keyword matching logic; can be upgraded to semantic search later
        for video in all_videos:
            if any(word.lower() in video.lower() for word in scene.split()):
                matched_files.append(os.path.join(dataset_path, video))
                break 
    return matched_files

from moviepy.editor import VideoFileClip, concatenate_videoclips

def assemble_video(video_paths, output_name="final_video.mp4"):
    """Stitches video clips into a single file."""
    clips = [VideoFileClip(p).subclip(0, 5) for p in video_paths] # Limits clips to 5s
    final_clip = concatenate_videoclips(clips, method="compose")
    final_clip.write_videofile(output_name, fps=24)
    print(f"Success! Video saved as {output_name}")

if __name__ == "__main__":
    # 1. Your input "Vibe"
    prompt = "A futuristic neon city in the rain" 
    
    # 2. Set your local path (Change this to where your videos are)
