import ollama

def generate_script(user_prompt):
    """Uses Ollama to generate a scene-by-scene script."""
    system_instruction = "You are a director. Break the prompt into 3 scenes. Output ONLY a list of descriptions."
    
    response = ollama.chat(
        model='llama3.2', 
        messages=[
            {'role': 'system', 'content': system_instruction},
            {'role': 'user', 'content': user_prompt}
        ]
    )
    # Extract the script content
    return response['message']['content'].split('\n')

